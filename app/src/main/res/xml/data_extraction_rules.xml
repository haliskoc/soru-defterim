<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- P0-1 Güvenlik: hassas veriler cloud backup'tan hariç -->
        <exclude domain="sharedpref" path="soru_defteri_ayarlar.preferences_pb" />
        <exclude domain="sharedpref" path="soru_defteri_secure_prefs.xml" />
        <exclude domain="sharedpref" path="soru_defteri_secure_prefs.preferences_pb" />
        <exclude domain="database" path="soru_defteri.db" />
        <exclude domain="database" path="soru_defteri.db-journal" />
        <exclude domain="database" path="soru_defteri.db-shm" />
        <exclude domain="database" path="soru_defteri.db-wal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/soru_defteri_ayarlar.preferences_pb" />
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="images/" />
        <!-- Diğer dosyalar yedeklenebilir, root include yok - daraltılmış -->
    </cloud-backup>
    <device-transfer>
        <!-- D2D transferde de hassas veriler hariç -->
        <exclude domain="sharedpref" path="soru_defteri_ayarlar.preferences_pb" />
        <exclude domain="sharedpref" path="soru_defteri_secure_prefs.xml" />
        <exclude domain="sharedpref" path="soru_defteri_secure_prefs.preferences_pb" />
        <exclude domain="database" path="soru_defteri.db" />
        <exclude domain="database" path="soru_defteri.db-journal" />
        <exclude domain="database" path="soru_defteri.db-shm" />
        <exclude domain="database" path="soru_defteri.db-wal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/soru_defteri_ayarlar.preferences_pb" />
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="images/" />
    </device-transfer>
</data-extraction-rules>
